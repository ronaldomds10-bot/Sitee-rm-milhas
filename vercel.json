{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rmmilhas-m7esoy93s-ronaldomds10-2746s-projects.vercel.app/api/:path*"
    },
    {
      "source": "/assets/videos/:path*",
      "destination": "https://rmmilhas-m7esoy93s-ronaldomds10-2746s-projects.vercel.app/assets/videos/:path*"
    }
  ]
}
